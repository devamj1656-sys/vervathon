<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>CadenceLab — Speech Analytics</title>
<style>
:root{--bg:#0a1020;--panel:#121d31;--panel2:#0c1627;--line:#293a56;--txt:#edf3ff;--muted:#91a1bd;--cyan:#66e3dc;--violet:#a69bff;--orange:#ffbd75;--red:#ff7d8b;--green:#8be0ae}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(900px 500px at 80% -10%,#1c3152 0%,transparent 65%),var(--bg);color:var(--txt);font-family:Inter,system-ui,Segoe UI,sans-serif}.wrap{max-width:1240px;margin:auto;padding:25px 20px 45px}.top,.hero,.head{display:flex;justify-content:space-between;align-items:center;gap:16px}.brand{display:flex;gap:12px;align-items:center}.logo{width:43px;height:43px;border-radius:14px;background:linear-gradient(135deg,var(--cyan),var(--violet));display:grid;place-items:center;color:#071320;font-size:21px;font-weight:900}.brand h1{font-size:20px;margin:0}.brand p{font-size:12px;color:var(--muted);margin:3px 0}.badge,.pill{font-size:10px;color:var(--cyan);border:1px solid #31515c;padding:7px 10px;border-radius:999px;background:#10242c}.hero{align-items:flex-end;margin:30px 0 22px}.eyebrow{font-size:11px;letter-spacing:2px;color:var(--cyan);font-weight:800}.hero h2{font-size:clamp(28px,4vw,43px);letter-spacing:-1.4px;line-height:1.08;margin:9px 0}.hero p,.sub{font-size:13px;color:var(--muted);line-height:1.6;max-width:690px}.heroSide{text-align:right;color:var(--muted);font-size:12px;min-width:160px}.heroSide strong{display:block;font-size:20px;color:var(--txt);margin-bottom:4px}.grid{display:grid;grid-template-columns:360px minmax(0,1fr);gap:18px;align-items:start}.panel{background:linear-gradient(180deg,#131e33f5,#10192a);border:1px solid var(--line);border-radius:17px;padding:19px;box-shadow:0 15px 40px #0002;margin-bottom:17px}.panel h3{font-size:15px;margin:0}.sub{margin:7px 0 15px}.label{display:block;font-size:12px;font-weight:750;margin:15px 0 8px;color:#d5def0}.input,.select,textarea{width:100%;background:#091322;color:var(--txt);border:1px solid #2b3b56;border-radius:10px;padding:11px;font:inherit;font-size:12px;outline:none}.input:focus,.select:focus,textarea:focus{border-color:var(--cyan)}textarea{resize:vertical;min-height:110px;line-height:1.6}.drop{border:1px dashed #405778;background:#0c1525;border-radius:12px;padding:14px;text-align:center}.drop strong{display:block;font-size:12px;margin-bottom:6px}.drop small{display:block;color:var(--muted);font-size:10px;margin-bottom:8px}.drop input{font-size:11px;max-width:100%;color:var(--muted)}.btn{border:0;border-radius:10px;padding:12px 14px;font-weight:800;font-size:12px;cursor:pointer}.primary{background:linear-gradient(100deg,var(--cyan),#a2e8c4);color:#071722;width:100%;margin-top:13px}.secondary{background:#202e47;color:#e2ebfb;border:1px solid #334765}.rowBtns{display:flex;gap:8px;margin-top:10px}.rowBtns .btn{flex:1}.note{font-size:10px;color:var(--muted);line-height:1.55;margin-top:12px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:17px}.stat{padding:15px;background:#121d31;border:1px solid var(--line);border-radius:14px}.stat span{display:block;font-size:10px;color:var(--muted);margin-bottom:8px}.stat strong{font-size:24px}.stat small{display:block;color:var(--green);font-size:10px;margin-top:6px}.chart{height:205px;background:#0a1322;border:1px solid #263650;border-radius:12px;overflow:hidden}.chart canvas{width:100%;height:100%;display:block}.legend{font-size:10px;color:var(--muted);display:flex;gap:12px;flex-wrap:wrap}.dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:4px}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.feature{background:var(--panel2);border:1px solid #253650;border-radius:11px;padding:12px}.feature .name{font-size:11px;color:#d5def0}.feature strong{display:block;font-size:18px;margin:8px 0}.bar{height:4px;background:#26344c;border-radius:4px;overflow:hidden}.bar i{display:block;height:100%;background:var(--cyan)}.feature small{display:block;color:var(--muted);font-size:10px;margin-top:7px}.issues{display:flex;flex-direction:column;gap:9px}.issue{display:grid;grid-template-columns:60px 1fr auto;gap:10px;background:#0d1728;border:1px solid #2a3b55;border-radius:11px;padding:12px}.time{font-size:10px;font-weight:800;color:var(--orange);background:#302619;border-radius:7px;padding:8px 4px;text-align:center}.issue h4{font-size:12px;margin:0 0 5px}.issue p{font-size:11px;line-height:1.5;color:var(--muted);margin:0}.tag{font-size:9px;padding:5px 7px;border-radius:7px;background:#332a20;color:var(--orange);height:max-content}.tag.good{background:#173329;color:var(--green)}.tableWrap{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:11px;min-width:530px}th,td{text-align:left;padding:10px;border-bottom:1px solid #293952}th{color:#aebdd4;font-size:10px}td{color:#dbe5f6}.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(135px,1fr));gap:10px}.step{padding:12px;border:1px solid #293952;background:#0c1627;border-radius:11px}.step b{font-size:12px;display:block;margin-bottom:6px}.step span{font-size:10px;color:var(--muted);line-height:1.5;display:block}.footer{text-align:center;color:#63738e;font-size:10px;margin-top:22px}@media(max-width:900px){.grid{grid-template-columns:1fr}.hero{align-items:flex-start;flex-direction:column}.heroSide{text-align:left}.stats{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.wrap{padding:16px 11px}.panel{padding:14px}.features{grid-template-columns:repeat(2,1fr)}.issue{grid-template-columns:52px 1fr}.issue .tag{grid-column:2;justify-self:start}.top{align-items:flex-start}.badge{font-size:9px}}
</style></head>
<body><div class="wrap">
<header class="top"><div class="brand"><div class="logo">C</div><div><h1>CadenceLab</h1><p>Speech analytics · temporal flaw detection</p></div></div><div class="badge">● HACKATHON PROTOTYPE</div></header>
<section class="hero"><div><div class="eyebrow">Speech performance intelligence</div><h2>Make every second of a speech count.</h2><p>Generate an ideal voiceover from your speech context, compare it with a participant recording, and review time-bound delivery observations.</p></div><div class="heroSide"><strong id="statusText">Ready to analyse</strong><span id="durationText">Add your transcript to begin</span></div></section>
<div class="grid"><aside>
<section class="panel"><h3>01 · Create ideal voiceover</h3><p class="sub">No reference audio upload is needed. CadenceLab can read your transcript aloud using your selected delivery context.</p>
<label class="label" for="context">Speech context / delivery instructions</label><textarea id="context" style="min-height:75px" placeholder="Example: Persuasive speech for a college competition. Sound confident, clear, inspiring, with deliberate pauses and emphasis on key phrases.">Persuasive speech for a college competition. Speak clearly and confidently, with a steady pace, natural pauses, and an inspiring tone.</textarea>
<label class="label" for="transcript">Speech transcript</label><textarea id="transcript">The future belongs to those who prepare for it today. We do not move forward by waiting for the perfect moment; we move forward by taking the next clear step.</textarea>
<label class="label" for="voice">Voice</label><select id="voice" class="select"><option value="">Default browser voice</option></select>
<label class="label" for="rate">Speaking pace <span id="rateVal" style="color:var(--cyan)">1.00×</span></label><input id="rate" class="input" type="range" min=".65" max="1.25" value="1" step=".05" style="padding:0;border:0">
<label class="label" for="pitch">Voice pitch <span id="pitchVal" style="color:var(--cyan)">1.00×</span></label><input id="pitch" class="input" type="range" min=".7" max="1.3" value="1" step=".05" style="padding:0;border:0">
<div class="rowBtns"><button class="btn primary" id="speakBtn" style="margin:0">▶ Generate voiceover</button><button class="btn secondary" id="stopBtn">■ Stop</button></div>
<p class="note">Voiceover uses your browser's built-in text-to-speech voices. The context guides the delivery settings only indirectly; this browser feature cannot reliably interpret all instructions such as emotion or rhetorical emphasis.</p></section>
<section class="panel"><h3>02 · Participant recording</h3><p class="sub">Upload the participant’s speech. Use the same transcript so comparisons remain meaningful.</p><div class="drop" id="partDrop"><strong id="partName">Choose participant audio</strong><small>WAV, MP3, M4A or OGG</small><input type="file" id="partFile" accept="audio/*"></div><button class="btn primary" id="analyseBtn">Analyse participant →</button><button class="btn secondary" id="demoBtn" style="width:100%;margin-top:9px">Load interactive demo</button><p class="note">Browser-generated speech is played aloud but is not available here as a decoded audio file for acoustic analysis. This prototype analyses the uploaded participant recording and uses a demo baseline for chart illustration. Full reference-to-participant measurement needs a TTS backend that returns an audio file.</p></section>
</aside>
<main>
<div class="stats"><div class="stat"><span>DELIVERY INDICATORS</span><strong id="score">—</strong><small id="scoreDelta">Waiting for audio</small></div><div class="stat"><span>DURATION</span><strong id="duration">—</strong><small>Participant clip</small></div><div class="stat"><span>PAUSE CANDIDATES</span><strong id="pauses">—</strong><small>Low-energy regions</small></div><div class="stat"><span>ANALYSIS COVERAGE</span><strong id="coverage">—</strong><small>Audio decoded</small></div></div>
<section class="panel"><div class="head"><h3>Temporal delivery overlay</h3><div class="legend"><span><i class="dot" style="background:var(--cyan)"></i>Illustrative baseline</span><span><i class="dot" style="background:var(--violet)"></i>Participant</span><span><i class="dot" style="background:var(--red)"></i>Flagged span</span></div></div><p class="sub">Compare relative acoustic energy across time. Until a generated reference audio file is connected, the baseline shown in demo mode is illustrative.</p><div class="chart"><canvas id="chart"></canvas></div><p class="note" id="chartNote">Load the demo or analyse a participant recording to populate the chart.</p></section>
<section class="panel"><div class="head"><h3>Audio feature summary</h3><span class="pill">Signal-level indicators</span></div><p class="sub">Measurements below are computed from participant audio when uploaded. They are indicators, not a definitive judgement of speaking quality.</p><div class="features"><div class="feature"><div class="name">Energy consistency</div><strong id="energyVal">—</strong><div class="bar"><i id="energyBar" style="width:0"></i></div><small id="energyNote">Awaiting audio</small></div><div class="feature"><div class="name">Pause control</div><strong id="pauseVal">—</strong><div class="bar"><i id="pauseBar" style="width:0"></i></div><small id="pauseNote">Awaiting audio</small></div><div class="feature"><div class="name">Signal descriptor</div><strong id="clarityVal">—</strong><div class="bar"><i id="clarityBar" style="width:0"></i></div><small id="clarityNote">Zero-crossing proxy</small></div></div></section>
<section class="panel"><div class="head"><h3>Explainable feedback</h3><span class="pill" id="issueCount">0 observations</span></div><div id="issues" class="issues"><div class="note">Upload a participant recording or load the demo to view timestamped observations.</div></div></section>
</main></div>
<section class="panel"><div class="head"><h3>How the full system works</h3><span class="pill">Proposed pipeline</span></div><p class="sub">This is the intended processing pipeline for the complete hackathon solution.</p><div class="steps"><div class="step"><b>1 · Context + transcript</b><span>Set the speech purpose, audience, desired delivery, and exact words.</span></div><div class="step"><b>2 · Ideal voiceover</b><span>Generate reference speech with a text-to-speech service that returns an audio file.</span></div><div class="step"><b>3 · Word alignment</b><span>Use forced alignment, such as WhisperX, to map each transcript word to start/end timestamps.</span></div><div class="step"><b>4 · Feature extraction</b><span>Use librosa / NumPy to measure RMS energy, pitch, MFCCs, spectral features and pauses.</span></div><div class="step"><b>5 · Compare + explain</b><span>Compare corresponding words or windows and show possible issues with evidence and recommendations.</span></div></div></section>
<section class="panel"><div class="head"><h3>Audio features used</h3><span class="pill">Quick reference</span></div><div class="tableWrap"><table><thead><tr><th>Feature</th><th>Measures</th><th>Possible use</th><th>Limitation</th></tr></thead><tbody><tr><td>RMS energy</td><td>Short-frame signal strength</td><td>Spot changes in vocal energy</td><td>Also affected by mic distance and gain</td></tr><tr><td>Pitch (F0)</td><td>Fundamental frequency</td><td>Review pitch range / monotony</td><td>Depends on speaker and speaking style</td></tr><tr><td>Pause duration</td><td>Silence or low-energy spans</td><td>Find long pause candidates</td><td>Some pauses are intentional</td></tr><tr><td>MFCC</td><td>Short-time spectral envelope</td><td>Compare vocal sound patterns</td><td>Does not directly score rhetoric</td></tr><tr><td>Speaking rate</td><td>Words per minute</td><td>Review rushing or slow pacing</td><td>Requires reliable transcript and alignment</td></tr></tbody></table></div><p class="note">Suggested backend: Python + FastAPI, WhisperX for word-level alignment, and librosa / NumPy for audio features. Use your own permitted recordings for contrastive dataset examples.</p></section>
<div class="footer">CadenceLab · Hackathon proof of concept · Acoustic differences are evidence for review, not automatic proof of a flaw.</div></div>
<script>
const $=id=>document.getElementById(id);let participantFile=null,partStats=null,demo=false;const canvas=$('chart'),ctx=canvas.getContext('2d');
function fmt(s){return Math.floor(s/60)+':'+String(Math.floor(s%60)).padStart(2,'0')}
function seed(n,k,base){let x=k;return Array.from({length:n},(_,i)=>{x=(x*9301+49297)%233280;return Math.max(.04,Math.min(.98,base+.24*(x/233280-.5)+Math.sin(i*.47+k)*.12))})}
function draw(){let w=canvas.width=canvas.clientWidth*devicePixelRatio,h=canvas.height=canvas.clientHeight*devicePixelRatio;ctx.clearRect(0,0,w,h);ctx.fillStyle='#0a1322';ctx.fillRect(0,0,w,h);let p=32*devicePixelRatio;ctx.strokeStyle='#1e2b42';for(let i=0;i<5;i++){let y=p+i*(h-2*p)/4;ctx.beginPath();ctx.moveTo(p,y);ctx.lineTo(w-p,y);ctx.stroke()}let a=seed(75,7,.58),b=partStats?.series||seed(75,19,.45);function line(arr,c){ctx.beginPath();ctx.strokeStyle=c;ctx.lineWidth=2*devicePixelRatio;arr.forEach((v,i)=>{let x=p+i*(w-2*p)/(arr.length-1),y=h-p-v*(h-2*p);i?ctx.lineTo(x,y):ctx.moveTo(x,y)});ctx.stroke()}if(partStats?.flags)partStats.flags.forEach(f=>{let x=p*f.start/Math.max(partStats.duration,1)*(w-2*p);let ww=Math.max(15*devicePixelRatio,(f.end-f.start)/Math.max(partStats.duration,1)*(w-2*p));ctx.fillStyle='#ff7d8b22';ctx.fillRect(x,p,Math.min(ww,w-p-x),h-2*p)});line(a,'#66e3dc');line(b,'#a69bff')}
window.addEventListener('resize',draw);
function populateVoices(){let voices=speechSynthesis.getVoices(),sel=$('voice'),old=sel.value;sel.innerHTML='<option value="">Default browser voice</option>';voices.forEach((v,i)=>{let o=document.createElement('option');o.value=String(i);o.textContent=v.name+' ('+v.lang+')';sel.appendChild(o)});if(old)sel.value=old}
if('speechSynthesis'in window){populateVoices();speechSynthesis.onvoiceschanged=populateVoices}
$('rate').oninput=()=> $('rateVal').textContent=Number($('rate').value).toFixed(2)+'×';
$('pitch').oninput=()=> $('pitchVal').textContent=Number($('pitch').value).toFixed(2)+'×';
$('speakBtn').onclick=()=>{let text=$('transcript').value.trim();if(!text){$('statusText').textContent='Enter transcript first';return}if(!('speechSynthesis'in window)){alert('Text-to-speech is not supported in this browser. Try a recent version of Chrome or Edge.');return}speechSynthesis.cancel();let u=new SpeechSynthesisUtterance(text);let voices=speechSynthesis.getVoices();let ix=$('voice').value;if(ix!==''&&voices[Number(ix)])u.voice=voices[Number(ix)];u.rate=Number($('rate').value);u.pitch=Number($('pitch').value);u.onstart=()=>{$('statusText').textContent='Playing ideal voiceover';$('durationText').textContent='Generated from transcript'};u.onend=()=>{$('statusText').textContent='Voiceover finished'};u.onerror=()=>{$('statusText').textContent='Voiceover could not play'};speechSynthesis.speak(u)};
$('stopBtn').onclick=()=>{speechSynthesis.cancel();$('statusText').textContent='Voiceover stopped'};
async function decode(file){let AC=window.AudioContext||window.webkitAudioContext,ac=new AC(),buf=await ac.decodeAudioData(await file.arrayBuffer()),s=buf.getChannelData(0),frame=Math.max(1024,Math.floor(buf.sampleRate*.08)),raw=[],z=[];for(let i=0;i<s.length;i+=frame){let sum=0,c=0,prev=s[i]||0,end=Math.min(i+frame,s.length);for(let j=i;j<end;j++){sum+=s[j]*s[j];if(j>i&&((s[j]>=0)!==(prev>=0)))c++;prev=s[j]}raw.push(Math.sqrt(sum/Math.max(1,end-i)));z.push(c/Math.max(1,end-i))}let max=Math.max(...raw,.00001),series=raw.map(v=>v/max),thr=Math.max(.08,series.reduce((a,b)=>a+b,0)/series.length*.2),flags=[],on=null;series.forEach((v,i)=>{if(v<thr){if(on===null)on=i*.08}else if(on!==null){if(i*.08-on>=.24)flags.push({start:on,end:i*.08});on=null}});if(on!==null&&buf.duration-on>=.24)flags.push({start:on,end:buf.duration});return{duration:buf.duration,series,z,flags,pauses:flags.length}}
function showIssues(a){let list=[];partStats.flags.slice(0,5).forEach(f=>list.push({t:fmt(f.start)+'–'+fmt(f.end),h:'Possible pause / low-energy region',p:`From ${f.start.toFixed(1)} to ${f.end.toFixed(1)} seconds, the audio energy is below a local threshold. Replay this region to decide whether the pause is intentional or a delivery issue.`,tag:'TIMING'}));if(a.consistency<70)list.push({t:'Across clip',h:'Uneven vocal energy',p:'The measured amplitude varies noticeably. Check projection and whether key words remain audible. Recording gain may also explain this change.',tag:'ENERGY'});if(!list.length)list.push({t:'Whole clip',h:'No strong pause anomaly found',p:'The basic signal indicators look relatively stable. Listen for phrasing, emphasis, pronunciation and meaning before drawing conclusions.',tag:'REVIEW',good:true});$('issueCount').textContent=list.length+' observations';$('issues').innerHTML=list.map(i=>`<div class="issue"><div class="time">${i.t}</div><div><h4>${i.h}</h4><p>${i.p}</p></div><span class="tag ${i.good?'good':''}">${i.tag}</span></div>`).join('')}
function render(stats){partStats=stats;let mean=stats.series.reduce((a,b)=>a+b,0)/stats.series.length,variance=stats.series.reduce((a,b)=>a+(b-mean)**2,0)/stats.series.length,energy=Math.max(30,Math.min(98,Math.round(100-variance*190))),pause=Math.max(35,Math.min(98,100-stats.pauses*7)),z=stats.z.reduce((a,b)=>a+b,0)/stats.z.length,clarity=Math.max(45,Math.min(96,Math.round(88-Math.abs(z-.08)*140)));$('score').textContent=Math.round(energy*.45+pause*.35+clarity*.2)+'/100';$('scoreDelta').textContent='Signal-based estimate only';$('duration').textContent=fmt(stats.duration);$('pauses').textContent=stats.pauses;$('coverage').textContent='100%';$('durationText').textContent='Participant: '+fmt(stats.duration);[['energy',energy,energy>75?'Relatively steady energy':'Review energy variation'],['pause',pause,stats.pauses+' pause candidates'],['clarity',clarity,'Zero-crossing proxy only']].forEach(([id,v,n])=>{$(id+'Val').textContent=v+'%';$(id+'Bar').style.width=v+'%';$(id+'Note').textContent=n});$('chartNote').textContent='Participant waveform shown against an illustrative baseline; reference audio comparison is not yet connected.';showIssues({consistency:energy});draw();$('statusText').textContent='Analysis complete'}
$('partFile').onchange=e=>{participantFile=e.target.files[0]||null;if(participantFile){$('partName').textContent=participantFile.name;$('statusText').textContent='Participant audio added'}};
$('analyseBtn').onclick=async()=>{if(!participantFile&&!demo){$('statusText').textContent='Upload participant audio or load demo';return}try{$('statusText').textContent='Analysing audio…';if(participantFile)render(await decode(participantFile));else render({duration:16.8,series:seed(90,19,.44),z:Array(90).fill(.1),flags:[{start:3.2,end:4.1},{start:7.8,end:8.6},{start:12.1,end:13}],pauses:3})}catch(e){$('statusText').textContent='Could not decode audio';$('issues').innerHTML='<div class="note">Try a WAV or MP3 recording supported by your browser.</div>'}};
$('demoBtn').onclick=()=>{demo=true;participantFile=null;$('partName').textContent='Demo participant recording';$('transcript').value='The future belongs to those who prepare for it today. We do not move forward by waiting for the perfect moment; we move forward by taking the next clear step.';render({duration:16.8,series:seed(90,19,.44),z:Array(90).fill(.1),flags:[{start:3.2,end:4.1},{start:7.8,end:8.6},{start:12.1,end:13}],pauses:3})};
draw();
</script></body></html>
